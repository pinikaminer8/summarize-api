    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test:huggingface": "tsx src/scripts/test-huggingface.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YarivGilad/summarize-api.git"
  },
